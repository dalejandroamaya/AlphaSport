{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "AlphaSport Escritorio (JavaFX)",
      "request": "launch",
      "mainClass": "alphasport.ui.escritorio.AlphaSportEscritorio",
      "vmArgs": "--enable-native-access=ALL-UNNAMED",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "java",
      "name": "AlphaSport Web (navegador)",
      "request": "launch",
      "mainClass": "alphasport.ui.AlphaSportApp",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "type": "java",
      "name": "Prueba automatica (SimulacionFormatos)",
      "request": "launch",
      "mainClass": "alphasport.service.SimulacionFormatos",
      "cwd": "${workspaceFolder}"
    }
  ]
}
